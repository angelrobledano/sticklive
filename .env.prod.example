# ============================================================
# Producción — copia a .env.prod en el VPS y rellena.
# .env.prod NUNCA se commitea.
#
# Es la FUENTE de valores del compose (--env-file .env.prod). Desde #300 cada
# servicio declara explícitamente qué variables consume (docker-compose.prod.yml):
# añadir una variable aquí NO la inyecta en todos los contenedores, hay que
# declararla además en el servicio correspondiente (environment:).
# ============================================================

# Postgres (el host 'postgres' lo inyecta docker-compose)
POSTGRES_USER=sports_user
POSTGRES_PASSWORD=CAMBIA_ESTO_password_larga_aleatoria
POSTGRES_DB=sports_results
# Rol de aplicación DML-only (#298): api y etl conectan con él; migrate/DDL
# sigue con POSTGRES_USER. La password se fija en el servidor con:
#   ALTER ROLE sticklive_app WITH PASSWORD '...';
APP_DB_PASSWORD=CAMBIA_ESTO_otra_password_larga_distinta

# Scraping
# Con COMPETITION_SOURCES_DRIVEN=1 (recomendado), el cron itera las competiciones
# activas de la tabla `competition_sources` y NO necesita SEASON_ID/IDC. Alta de
# una liga = un INSERT en esa tabla, sin tocar el entorno.
COMPETITION_SOURCES_DRIVEN=1
# DEPRECADOS — sólo para usos manuales de run-pipeline en modo single (--season-id
# / --idc los sustituyen). El cron ya no los usa; cron-live los acepta como
# retrocompat opcional. Se pueden dejar vacíos.
SEASON_ID=
IDC=

# API / Web (URLs públicas tras Caddy: /api → Hono)
API_BASE_URL=https://sticklive.eu/api
WEB_BASE_URL=https://sticklive.eu
NEXT_PUBLIC_API_URL=https://sticklive.eu/api
NEXT_PUBLIC_SITE_URL=https://sticklive.eu
# Vacío = la web deriva la temporada actual de /competitions (recomendado).
NEXT_PUBLIC_SEASON_ID=

# Admin
ADMIN_TOKEN=CAMBIA_ESTO_otro_token_aleatorio

# PostHog (analítica)
POSTHOG_API_KEY=phc_p6kF5DziJthid4wyrAnRSBnGFY5pibi8YKHJTnrqY9Uk
POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_p6kF5DziJthid4wyrAnRSBnGFY5pibi8YKHJTnrqY9Uk
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# SMTP — magic links por email (Brevo/Resend/etc). Sin SMTP_HOST,
# POST /auth/verify responde 503: NUNCA devuelve el enlace en la respuesta
# (el modo dev que lo devuelve exige AUTH_DEV_LINKS=1 y no-producción).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=CAMBIA_usuario_smtp
SMTP_PASS=CAMBIA_clave_smtp
SMTP_FROM=Stick Live <no-reply@sticklive.eu>

# Google OAuth (console.cloud.google.com → Credentials → OAuth Client ID web)
# Redirect URI autorizada: https://sticklive.eu/api/auth/google/callback
GOOGLE_CLIENT_ID=CAMBIA_xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CAMBIA_GOCSPX-xxx

# Firma del `state` de OAuth (HMAC, apps/api/src/lib/auth-state.ts). Si falta,
# cae a GOOGLE_CLIENT_SECRET, pero definir uno propio desacopla la rotación de
# ambas cosas. Inclúyelo en la copia cifrada del .env.prod (#290).
AUTH_STATE_SECRET=CAMBIA_ESTO_secreto_aleatorio_para_oauth_state

# Stripe — SOLO si los pagos premium están ACTIVOS. Hoy están apagados: si no se
# activan, deja estas tres vacías (la API arranca igual; el checkout responde 503
# hasta que haya clave). Redsys ya no existe en la API.
# Claves en dashboard.stripe.com → Developers → API keys.
# Webhook: añadir endpoint https://sticklive.eu/api/payments/stripe/webhook
# (evento checkout.session.completed) y copiar su signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PREMIUM_PRICE_EUR_CENTS=499

# Google Play Billing — verificación SERVER-SIDE de las compras premium hechas
# en la app (suscripción anual + compra única "para siempre"). Mismo criterio
# que Stripe: SOLO si la compra en la app está ACTIVA. Deja las credenciales
# vacías y la feature queda apagada (la API arranca igual; POST
# /payments/play/verify responde 503 hasta que haya credenciales).
# Credenciales: Play Console → Configuración → Acceso a la API → vincula la
# service account de Google Cloud y descarga su JSON. El EMAIL es su
# client_email; la PRIVATE_KEY es su private_key con los \n literales, tal
# cual salen del JSON (el código los normaliza).
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_PRIVATE_KEY=
# Package name de la app publicada (debe coincidir con las compras). Vacío =
# usa el defecto del código (eu.sticklive.app).
GOOGLE_PLAY_PACKAGE_NAME=

# Publicidad web (Google AdSense) — LISTO PERO APAGADO (#382).
# Interruptor maestro: si NEXT_PUBLIC_ADSENSE_CLIENT está vacío, la web NO carga
# AdSense, no pide consentimiento y no reserva ningún hueco de anuncio (cero
# requests a Google). Los SLOT_* son los ids de bloque (data-ad-slot) creados en
# el panel de AdSense; si el slot de una superficie falta, esa superficie
# simplemente no muestra anuncio.
# ⚠️ Son variables de BUILD (NEXT_PUBLIC_*): se hornean en el bundle al construir.
# Definirlas aquí NO basta — hay que añadirlas también como build args del
# servicio `web` en docker-compose.prod.yml y redesplegar con `--build`.
# Guía de activación y notas de política: docs/monetizacion.md.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_SUMMARY=
NEXT_PUBLIC_ADSENSE_SLOT_STATS=
NEXT_PUBLIC_ADSENSE_SLOT_INTERSTITIAL=
# 0 = sin interstitial (recomendado al principio); 1 = interstitial no intrusivo.
NEXT_PUBLIC_ADS_INTERSTITIAL=0
# Inserta un banner inline cada N resultados de la lista (p. ej. 6). 0 = ninguno.
NEXT_PUBLIC_ADS_LIST_EVERY=0

# Web Push (genera el par con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=CAMBIA_clave_publica
VAPID_PRIVATE_KEY=CAMBIA_clave_privada
VAPID_SUBJECT=mailto:admin@tudominio.example
NEXT_PUBLIC_VAPID_PUBLIC_KEY=CAMBIA_misma_clave_publica

# Logging
LOG_LEVEL=info

# Sentry (alertas de errores + alertas del pipeline: cron monitor del directo,
# scrape-health, watchdog, partition-guard). SIN ESTA VARIABLE TODA LA
# ALERTABILIDAD ES NO-OP SILENCIOSO: verifícala en cada reconstrucción de .env.prod.
SENTRY_DSN=
# Solo para subir sourcemaps en el build de la web (build arg del compose).
# Se pasa SOLO como build arg (#300): con el env_file retirado no llega al
# runtime de ningún contenedor. Si no se define, el build sigue igual (sin
# sourcemaps).
# SENTRY_AUTH_TOKEN=

# ── Vigilante de salud del scraping (scrape-health-watch, diario 06:00 UTC) ──
# Lee el ÚLTIMO run de cada scraper en scrape_logs y alerta a Sentry si está
# parado, si su último run falló, si acabó OK con 0 filas, o si un scraper
# esperado no tiene ninguna ejecución. Sin SENTRY_DSN no avisa a ningún sitio.
# Horas sin correr para considerar un scraper "parado" (defecto 26).
SCRAPE_STALE_HOURS=26
# scraper_key que DEBEN aparecer en scrape_logs. Si falta alguno, alerta
# 'missing'. FEP es la fuente siempre activa. NO incluyas aquí una fuente de
# temporada (p.ej. worldskate_hockey) mientras esté dormida: daría un falso
# 'missing' hasta que arranque su próxima competición.
SCRAPE_EXPECTED_KEYS=fep_hockey
# World Skate: días de margen tras el fin de una edición antes de dejar de
# scrapearla (sidgad retira el calendario al poco de terminar el torneo → 404).
# Las ediciones dormidas se registran como 'skipped' y se avisa una vez.
WSE_SCRAPE_GRACE_DAYS=3

# UUID de la fila data_sources con scraper_key='fep_hockey' (obligatorio para el
# scraper; el ETL lanza error claro si falta o no es UUID).
FEP_SOURCE_ID=
