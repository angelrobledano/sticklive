# ============================================================
# Producción — copia a .env.prod en el VPS y rellena.
# .env.prod NUNCA se commitea.
# ============================================================

# Postgres (el host 'postgres' lo inyecta docker-compose)
POSTGRES_USER=sports_user
POSTGRES_PASSWORD=CAMBIA_ESTO_password_larga_aleatoria
POSTGRES_DB=sports_results

# Scraping
SEASON_ID=e6ab9d19-cc4b-4095-a9ce-4407a4000737
IDC=3150,3481

# API / Web (URLs públicas tras Caddy: /api → Hono)
API_BASE_URL=https://sticklive.eu/api
WEB_BASE_URL=https://sticklive.eu
NEXT_PUBLIC_API_URL=https://sticklive.eu/api
NEXT_PUBLIC_SITE_URL=https://sticklive.eu
NEXT_PUBLIC_SEASON_ID=e6ab9d19-cc4b-4095-a9ce-4407a4000737

# Admin
ADMIN_TOKEN=CAMBIA_ESTO_otro_token_aleatorio

# PostHog (analítica)
POSTHOG_API_KEY=phc_p6kF5DziJthid4wyrAnRSBnGFY5pibi8YKHJTnrqY9Uk
POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_p6kF5DziJthid4wyrAnRSBnGFY5pibi8YKHJTnrqY9Uk
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# SMTP — magic links por email (Brevo/Resend/etc). Sin SMTP_HOST,
# la API queda en modo dev: el enlace se muestra en pantalla (INSEGURO en prod).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=CAMBIA_usuario_smtp
SMTP_PASS=CAMBIA_clave_smtp
SMTP_FROM=Stick Live <no-reply@sticklive.eu>

# Google OAuth (console.cloud.google.com → Credentials → OAuth Client ID web)
# Redirect URI autorizada: https://sticklive.eu/api/auth/google/callback
GOOGLE_CLIENT_ID=CAMBIA_xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CAMBIA_GOCSPX-xxx

# Stripe (proveedor de pago activo; Redsys queda como alternativo)
# Claves en dashboard.stripe.com → Developers → API keys.
# Webhook: añadir endpoint https://sticklive.eu/api/payments/stripe/webhook
# (evento checkout.session.completed) y copiar su signing secret.
STRIPE_SECRET_KEY=CAMBIA_sk_live_o_sk_test
STRIPE_WEBHOOK_SECRET=CAMBIA_whsec_xxx
PREMIUM_PRICE_EUR_CENTS=499

# Web Push (genera el par con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=CAMBIA_clave_publica
VAPID_PRIVATE_KEY=CAMBIA_clave_privada
VAPID_SUBJECT=mailto:robledano@gmail.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=CAMBIA_misma_clave_publica

# Logging
LOG_LEVEL=info
