# API en desarrollo: IP LAN del PC (el dispositivo/emulador no ve localhost)
EXPO_PUBLIC_API_URL=http://192.168.1.50:3000

# Sentry (Task 5.1): DSN de la app móvil. Se crea como cliente/plataforma PROPIA
# de la app en el proyecto Sentry existente — NUNCA reutilizar el DSN del
# servidor (son errores distintos con stacks distintos). Vacío = Sentry.init no
# se llama (desarrollo sin telemetría). Nota: publicar source maps exige además
# un sentryCli authToken como secret de EAS en build (paso de release).
EXPO_PUBLIC_SENTRY_DSN=

# PostHog (Task 5.1): clave pública (write-only) del proyecto EU — puede ser la
# del mismo proyecto que la web (la app se distingue por propiedades/platform).
# Vacío = analítica no-op (la app funciona igual y nada se envía).
EXPO_PUBLIC_POSTHOG_KEY=
# Host de ingesta (EU por defecto; solo tocar si cambia la región del proyecto).
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Web pública donde ocurre la compra premium (la app la abre en el navegador
# del sistema: client.ts la usa como base). Vacía usa el fallback
# (https://sticklive.eu) — solo definir si cambia el dominio.
EXPO_PUBLIC_WEB_URL=

# AdMob (docs/monetizacion.md §6): unit ids de los banners adaptativos (listas
# y ficha no-live). En __DEV__ el código usa SIEMPRE los TestIds de Google
# (hardcodeados en AdBanner); estas variables SOLO se definen en el perfil
# `production` de EAS — clicar anuncios reales en builds dev/preview es causa
# de baneo. Vacías = fail-closed (sin banner). Nunca con IDs reales en el repo.
EXPO_PUBLIC_ADMOB_BANNER_LIST=
EXPO_PUBLIC_ADMOB_BANNER_MATCH=
