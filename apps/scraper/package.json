{
  "name": "@sports/scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --loader ts-node/esm src/index.ts",
    "dev": "nodemon --watch src --exec \"npx tsx src/index.ts\"",
    "build": "tsc",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "casos:actualizar": "ACTUALIZAR_CASOS=1 vitest run src/casos-reales"
  },
  "dependencies": {
    "@sentry/node": "^10.59.0",
    "@sports/analytics": "*",
    "@sports/logger": "*",
    "@sports/shared-types": "*",
    "@sports/etl": "*",
    "@sports/db": "*",
    "playwright": "^1.64.0",
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "nodemon": "^3.1.0",
    "vitest": "^1.6.0",
    "typescript": "^5.4.0"
  }
}
