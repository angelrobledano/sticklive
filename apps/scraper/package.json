{
  "name": "@sports/scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --loader ts-node/esm src/index.ts",
    "dev": "nodemon --watch src --exec \"npx tsx src/index.ts\"",
    "build": "tsc",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "probe": "node --loader ts-node/esm src/scrapers/fep/fep-network-probe.ts"
  },
  "dependencies": {
    "@sports/analytics": "*",
    "@sports/logger": "*",
    "@sports/shared-types": "*",
    "@sports/etl": "*",
    "@sports/db": "*",
    "playwright": "^1.61.1",
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "ts-node": "^10.9.0",
    "nodemon": "^3.1.0",
    "vitest": "^4.1.10",
    "typescript": "^7.0.2"
  }
}
