{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM: los probes y fep-catalog ejecutan código dentro de page.evaluate
    // (contexto de navegador: document, HTMLElement, click…). Necesitan los
    // tipos del DOM aunque el resto corra en Node (auditoría Q2).
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@sports/analytics": [
        "../../packages/analytics/src/index.ts"
      ],
      "@sports/shared-types": [
        "../../packages/shared-types/src/index.ts"
      ],
      "@sports/logger": [
        "../../packages/logger/src/index.ts"
      ],
      "@sports/db": [
        "../../packages/db/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
