    "@sports/db": "*",
    "@sports/logger": "*",
    "@sports/shared-types": "*",
    "hono": "^4.12.25",
    "nodemailer": "^8.0.11",
    "stripe": "^22.2.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
