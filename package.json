{
  "name": "sports-results-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "description": "Plataforma de resultados deportivos en tiempo real — hockey sobre patines y más",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:migrate": "npm run migrate --workspace=packages/db",
    "db:seed": "npm run seed --workspace=packages/db",
    "scraper:run": "npm run start --workspace=apps/scraper",
    "etl:run": "npm run start --workspace=apps/etl"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "turbo": "^2.10.5",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.66.0",
    "@sentry/node": "^10.59.0"
  }
}
