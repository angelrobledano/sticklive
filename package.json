{
  "name": "sports-results-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "description": "Plataforma de resultados deportivos en tiempo real — hockey sobre patines y más",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:migrate": "npm run migrate --workspace=packages/db",
    "db:seed": "npm run seed --workspace=packages/db",
    "scraper:run": "npm run start --workspace=apps/scraper",
    "etl:run": "npm run start --workspace=apps/etl",
    "build:server": "node scripts/build-server.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:docker": "docker compose -f docker-compose.test.yml up -d --wait && DATABASE_URL=postgresql://test:test@127.0.0.1:5433/sticklive_test npm run test:integration; docker compose -f docker-compose.test.yml down"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.63.0",
    "@sentry/node": "^10.59.0"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "^8.5.18"
  }
}
