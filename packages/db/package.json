  },
  "dependencies": {
    "@sports/logger": "*",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  }
}
