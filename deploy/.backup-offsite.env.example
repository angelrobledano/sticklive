# ============================================================
# Config del off-site de backups (copia fuera del VPS) — issue #289
#
# Sin este fichero, backup-db.sh solo guarda los dumps en /opt/backups (mismo
# disco que Postgres): si el VPS se pierde, se pierden BD y copias a la vez.
#
# Instalación (una vez, como root en el VPS):
#   1. Copia este ejemplo:
#        cp /opt/sticklive/deploy/.backup-offsite.env.example /opt/sticklive/.backup-offsite.env
#   2. Genera una clave SSH DEDICADA (no reutilices la del deploy):
#        ssh-keygen -t ed25519 -f /root/.ssh/storagebox -N ''
#   3. Autoriza la pública en la Storage Box (Hetzner: SFTP/rsync o panel).
#   4. Rellena OFFSITE_TARGET y OFFSITE_SSH_OPTS aquí abajo.
#   5. Restringe permisos (contiene el ping URL, que es un secreto):
#        chmod 600 /opt/sticklive/.backup-offsite.env
#   6. Prueba manual: /opt/sticklive/deploy/backup-db.sh
#      y comprueba el fichero en el destino remoto.
#
# Cargado por deploy/backup-db.sh y deploy/verify-backup.sh (se sourcea).
# ============================================================

# Destino rsync. Hetzner Storage Box = usuario + host + ruta.
# Obligatorio (si falta, el off-site se omite).
OFFSITE_TARGET=uXXXXXX@uXXXXXX.your-storagebox.de:backups/

# Opciones de SSH: puerto (Hetzner usa 23) y clave dedicada.
OFFSITE_SSH_OPTS=-p 23 -i /root/.ssh/storagebox -o StrictHostKeyChecking=accept-new

# ── Alertas de backup (#292) ─────────────────────────────────
# Opcional. Ping de éxito/fallo de backup-db.sh (y de verify-backup.sh si no
# defines VERIFY_PING_URL). Ejemplos:
#   healthchecks.io:  https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#   dead-man-snitch:  https://nosnch.in/xxxxxxxxxx
#   Sentry Cron:      https://o0.ingest.sentry.io/api/0/cron/<slug>/<key>/  (usa ?status=)
# BACKUP_PING_URL=

# ── Copia cifrada de .env.prod (#290) ────────────────────────
# Opcional. Claves PÚBLICAS para deploy/backup-env.sh (la privada se guarda
# FUERA del VPS; el servidor solo necesita la pública para cifrar).
# AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GPG_RECIPIENT=you@example.com
