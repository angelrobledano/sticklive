# === Base de Datos ===
DATABASE_URL=postgresql://sports_user:sports_pass@localhost:5432/sports_results
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# === Scraper ===
SCRAPER_CONCURRENCY=3
SCRAPER_RETRY_ATTEMPTS=3
SCRAPER_RETRY_DELAY_MS=2000
SCRAPER_REQUEST_TIMEOUT_MS=30000
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; SportsResultsBot/1.0)

# === ETL ===
ETL_BATCH_SIZE=100
ETL_DRY_RUN=false

# === API ===
API_PORT=3001
API_SECRET=change-me-in-production

# === Crons (expresiones cron) ===
# Cada 5 minutos durante partidos (ajustar por competición)
CRON_LIVE_RESULTS=*/5 * * * *
# Cada hora para clasificaciones y jornadas
CRON_STANDINGS=0 * * * *
# Diario a las 6am para datos estructurales (competiciones, equipos)
CRON_STRUCTURAL=0 6 * * *

# === Logging ===
LOG_LEVEL=info
LOG_FORMAT=json

# === Features ===
NODE_ENV=development
