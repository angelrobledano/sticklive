# ============================================================
# Stick Live — variables de entorno de DESARROLLO
# Copia a .env y ajusta. Referencia contrastada con el código.
# Producción: ver .env.prod.example (secretos solo en el VPS).
# ============================================================

# ── Base de datos (OBLIGATORIA: la API aborta sin ella) ─────
DATABASE_URL=postgresql://sports_user:sports_pass@localhost:5432/sports_results
# Ajustes finos del pool (opcionales)
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=15000
# DATABASE_QUERY_TIMEOUT_MS=15000

# ── API ──────────────────────────────────────────────────────
# Puerto de la API Hono (default 3000). La web corre en 3001.
PORT=3000
# URL pública de la API para construir enlaces (magic links). Default: http://localhost:3000
# API_BASE_URL=http://localhost:3000
# Origen(s) permitidos por CORS (separados por coma; siempre incluye la web)
WEB_BASE_URL=http://localhost:3001
# Panel de administración (header X-Admin-Token). Si está vacío, /admin/* responde 503.
ADMIN_TOKEN=
# Token servidor-a-servidor web→API (SSR/build). Opcional en desarrollo; si se
# define aquí, Next debe verlo (por ejemplo en apps/web/.env.local).
INTERNAL_API_TOKEN=

# ── Anti-scraping de la API (opcional; valores por defecto entre paréntesis) ──
# Cuota GLOBAL por IP para todas las lecturas de datos juntas (600/min).
# READ_GLOBAL_MAX=600
# READ_GLOBAL_WINDOW_MS=60000
# Cuota diaria por IP (50.000/día). Bajar solo si se vigilan NATs compartidos.
# READ_DAILY_MAX=50000
# READ_DAILY_WINDOW_MS=86400000
# Peticiones de lectura simultáneas por IP (8).
# READ_CONCURRENCY_MAX=8
# Detección de enumeración: entidades distintas por ventana (300/10 min) y
# duración del bloqueo temporal (15 min).
# ENUM_WINDOW_MS=600000
# ENUM_DISTINCT_MAX=300
# ENUM_BLOCK_MS=900000

# ── Autenticación ────────────────────────────────────────────
# Solo desarrollo: devuelve el magic link en la respuesta de /auth/verify.
# El código lo ignora si NODE_ENV=production. JAMÁS activarlo en producción.
# AUTH_DEV_LINKS=1
# Secreto para firmar el state de Google OAuth (opcional en dev)
# AUTH_STATE_SECRET=
# SMTP para magic links (Brevo/Resend/etc.). Sin SMTP_HOST, /auth/verify
# devuelve 503 salvo modo dev explícito (nunca filtra el enlace).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Stick Live <no-reply@sticklive.eu>
# Google OAuth (opcional en dev). Redirect: http://localhost:3000/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Web (NEXT_PUBLIC_* se hornean en el BUILD de producción) ─
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Opcional: fija la temporada por UUID. Si viene vacío, la web la deriva de /competitions.
NEXT_PUBLIC_SEASON_ID=
# Monetización (Stripe) dormida tras este flag
NEXT_PUBLIC_PREMIUM_ENABLED=0

# ── Analítica (PostHog EU) ───────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_DEBUG=1

# ── Web Push (VAPID) ─────────────────────────────────────────
# Generar par: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@sticklive.eu
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Pagos (Stripe; inactivo hasta NEXT_PUBLIC_PREMIUM_ENABLED=1) ─
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PREMIUM_PRICE_EUR_CENTS=499

# ── Sentry (alertas de errores y del pipeline de datos) ──────
# Sin SENTRY_DSN, toda la alertabilidad (cron monitor, scrape-health,
# watchdog) es no-op silencioso. Obligatorio en producción.
SENTRY_DSN=
# SENTRY_AUTH_TOKEN=   # solo para subir sourcemaps del build de la web

# ── Scraper / ETL ────────────────────────────────────────────
# UUID de la fila data_sources con scraper_key='fep_hockey' (lo pide el scraper).
# Se obtiene de la BD: SELECT id FROM data_sources WHERE scraper_key='fep_hockey';
FEP_SOURCE_ID=
# 1 = calendar/standings/fichas iteran todas las competiciones de competition_sources
COMPETITION_SOURCES_DRIVEN=1
# Procesar sin escribir (dry-run del loader)
ETL_DRY_RUN=false
# Lote de escritura del ETL
ETL_BATCH_SIZE=100
# Concurrencia de scraping (marcadores) y de descarga de actas
SCRAPE_CONCURRENCY=3
FICHA_CONCURRENCY=3
# HTTP del scraper
SCRAPER_REQUEST_TIMEOUT_MS=30000
SCRAPER_RETRY_DELAY_MS=2000
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; StickLive/1.0)
# Partido >STALE_LIVE_HOURS en 'live' → el watchdog lo degrada a 'scheduled'
STALE_LIVE_HOURS=5
# scrape-health: alerta si un scraper lleva más horas sin correr (diaria)
SCRAPE_STALE_HOURS=26
# Ajustes finos opcionales (defaults razonables en código):
# MAX_RUNTIME_MIN=180        # bucle activo máximo del directo (min)
# SSE_MAX_CONNECTIONS=1000   # conexiones SSE globales
# SSE_MAX_DURATION_MS=       # corte de conexión SSE (default 2 h)
# SCRAPE_LOGS_RETENTION_DAYS=30
# SIDGAD_BASE_URL= / SIDGAD_PORTAL= / SIDGAD_REFERER=   # fuentes alternativas
# MIGRATIONS_DIR= / ESCUDOS_DIR=                        # los fija la imagen de prod

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
